{
  "name": "technexus-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "prisma:generate": "npm run generate -w packages/db",
    "db:push": "npm run db:push -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:seed": "npm run seed -w packages/db"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "prisma": "^5.18.0",
    "prettier": "^3.2.5",
    "typescript": "^5.6.2"
  }
}
