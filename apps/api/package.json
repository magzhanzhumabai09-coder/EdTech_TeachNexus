{
  "name": "technexus-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "express": "^4.21.1",
    "cors": "^2.8.5",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "morgan": "^1.10.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "multer": "^1.4.5-lts.2",
    "prisma": "^5.20.0",
    "@prisma/client": "^5.20.0",
    "openai": "^4.72.1",
    "node-fetch": "^3.3.2",
    "eventsource-parser": "^1.1.2",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.19.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  }
}
