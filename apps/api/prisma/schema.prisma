datasource db {
  // Default to SQLite for local/dev. For Postgres, change provider to "postgresql"
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String
  name      String?
  classes   Class[]
  activities ActivityLog[]
  createdAt DateTime @default(now())
}

model Class {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  teacher     User         @relation(fields: [teacherId], references: [id])
  teacherId   String
  assignments Assignment[]
  exams       Exam[]
  createdAt   DateTime     @default(now())
}

model Assignment {
  id        String   @id @default(cuid())
  title     String
  dueDate   DateTime
  class     Class    @relation(fields: [classId], references: [id])
  classId   String
  createdAt DateTime @default(now())
}

model Exam {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  class     Class    @relation(fields: [classId], references: [id])
  classId   String
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  path      String
  method    String
  ip        String?
  userAgent String?
  at        DateTime @default(now())
}

