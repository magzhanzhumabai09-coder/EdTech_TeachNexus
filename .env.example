# TechNexus.Ai Environment Variables
# Copy this file to .env.local and fill in your values

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TechNexus.Ai

# Database (for future integration)
# DATABASE_URL=postgresql://user:password@localhost:5432/technexus
# DATABASE_URL=mongodb://localhost:27017/technexus

# Authentication (NextAuth.js - for future integration)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-key-here

# AI Services (for future integration)
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key

# Email Service (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-password

# File Upload
# UPLOAD_MAX_SIZE=10485760
# ALLOWED_FILE_TYPES=pdf,doc,docx,zip,jpg,png

# Calendar Integration
# GOOGLE_CALENDAR_CLIENT_ID=your-client-id
# GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
# OUTLOOK_CLIENT_ID=your-client-id
# OUTLOOK_CLIENT_SECRET=your-client-secret

# Analytics
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Optional Services
# SENTRY_DSN=your-sentry-dsn
# VERCEL_ANALYTICS=true
