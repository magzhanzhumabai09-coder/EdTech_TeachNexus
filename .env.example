# TechNexus.AI Environment Variables

# Next.js Configuration
NEXT_PUBLIC_APP_NAME=TechNexus.AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# API Configuration (for future use)
# NEXT_PUBLIC_API_URL=https://api.technexus.ai
# API_SECRET_KEY=your-secret-key-here

# Database Configuration (for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/technexus_ai

# Authentication (for future use)
# NEXTAUTH_SECRET=your-nextauth-secret
# NEXTAUTH_URL=http://localhost:3000

# AI Services Configuration (for future use)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Email Configuration (for future use)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password